[node name="ContentLabel" type="RichTextLabel" parent="InstructionsModal/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 15
bbcode_enabled = true
text = "[b][color=#55eeff]1. DI CHUYỂN & LÁI XE:[/color][/b]
• [b]W / S[/b]: Tiến lên / Lùi xe theo hướng mũi xe.
• [b]A / D[/b]: Xoay thân xe tăng sang trái / phải.

[b][color=#ffdd44]2. HỎA LỰC TÁC CHIẾN (CHUỘT TRÁI & CHUỘT PHẢI):[/color][/b]
• [b]Chuột trái (Vũ khí chính)[/b]: Pháo cối Parabola (xuyên tường AoE) / Song pháo AP / Rocket chùm dẫn đường (chọn tại Menu).
• [b]Chuột phải (Vũ khí phụ - 3 loại)[/b]:
  + [b]Súng Xuyên Giáp AP (Mặc định)[/b]: Sát thương cao, sơ tốc nhanh, tốc bắn và hồi lâu hơn.
  + [b]Súng Máy Liên Thanh[/b]: Tốc bắn cực nhanh, có cơ chế Quá nhiệt (Burn Out).
  + [b]Súng Shotgun Tán Xạ[/b]: Bắn chùm 6 mảnh đạn rẻ quạt uy lực hủy diệt cận chiến.
• [i][color=#ffaa55]*Lưu ý: Chỉ có thể điều chỉnh và trang bị vũ khí tại Menu chính trước khi xuất kích.*[/color][/i]

[b][color=#55ff88]3. KỸ NĂNG & ẨN THÂN TÁC CHIẾN:[/color][/b]
• [b]Phím Q (Sửa xe)[/b]: Hồi +35 HP (Hồi chiêu 12s).
• [b]Phím E (Khói mù)[/b]: Màn khói mù cố định 6s, AI mất dấu và tên lửa đuổi bị mù cảm biến bay loạn xạ!
• [b]Phím F (Dò Radar)[/b]: Quét toàn bản đồ định vị địch và lập tức khóa mục tiêu tên lửa.
• [b]Bụi cây ngụy trang[/b]: Núp vào bụi cây sẽ ẩn thân như khói. Nếu nổ súng từ bụi cây, vị trí sẽ bị lộ trong 2.5s!"

